<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#12081F</color>
    <color name="sheet">#1A0D31</color>
    <color name="card">#2A1650</color>
    <color name="text">#F3ECFF</color>
    <color name="muted">#B9A6E0</color>
    <color name="accent">#FF3D8B</color>
    <color name="accent2">#35E0C8</color>

    <style name="Theme.BlindTest" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent2</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="alertDialogTheme">@style/Theme.BlindTest.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.BlindTest.Dialog</item>
    </style>

    <style name="Theme.BlindTest.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorAccent">@color/accent2</item>
        <item name="colorControlNormal">@color/muted</item>
        <item name="colorControlActivated">@color/accent2</item>
        <item name="textColorAlertDialogListItem">@color/text</item>
        <item name="android:windowTitleStyle">@style/BlindTest.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/BlindTest.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/BlindTest.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/BlindTest.DialogButton</item>
        <item name="listPreferredItemHeightSmall">56dp</item>
    </style>

    <style name="BlindTest.DialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BlindTest.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BlindTest.DialogButton.Positive">
        <item name="android:textColor">@color/accent2</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
